pragma language_version >= 0.17.0;

import CompactStandardLibrary;
import "./Utils";
import Admin;
import StakerAction;
import Swap;
import "./GlobalProtocolLedgerStates";

export {
    CoinInfo, MintMetadata, Depositor, 
    Staker, DebtPositionStatus, ComplianceToken, 
    KYCTokenData, ValidityRange, ComplianceToken,
    depositToStabilityPool, checkStakeReward, withdrawStakeReward,
    withdrawStake, resetProtocolConfig, setSUSDTokenType,
    addTrustedOracle, removeTrustedOraclePk, addAdmin, transferAdminRole, stakers, admins, protocolStakeTVL,
    protocolReserveTVL, superAdmin, liquidationThreshold, MCR, LTV, trustedOracles, swapForsUSD, 
    swapsUSDForToken, sUSDTokenType, mintCounter, totalMint, validCollateralAssetType, liquidationCount
};

/* Describes the status of a user's debt position */
enum DebtPositionStatus { inactive, active, closed };

/* Depositor User Type */
export struct Depositor {
    id: Bytes<32>;
    metadataHash: Bytes<32>; 
    position: DebtPositionStatus;
    coinType: Bytes<32>;
    entryOraclePrice: Uint<32>;
};

/* Mapping for collateral deposit  --> encodedPk -> Depositor */
export ledger depositors: Map<Bytes<32>, Depositor>;

constructor(
    intialNonce_: Bytes<32>,
    initLiquidationThreshold_: Uint<8>,
    initialLTV_: Uint<8>,
    initialMCR_: Uint<8>,
    validCollateralAssetType_: Bytes<32>
    ) {
        superAdmin = ownPublicKey().bytes;
        totalMint = 0;
        // Liquidatin rate in percentage set at 80%
        liquidationThreshold = disclose(initLiquidationThreshold_);
        nonce = disclose(intialNonce_);
        LTV = disclose(initialLTV_);
        percent = 100;
        cumulativeScalingFactor = 1;
        MCR = disclose(initialMCR_);
        validCollateralAssetType = disclose(validCollateralAssetType_);
}


/* INTERACTIONS FOR COLLATERAL DEPOSITORS */
//Add oracle price
export circuit depositToCollateralPool(coin: CoinInfo, complianceToken_: ComplianceToken, oraclePrice_: Uint<32>): [] {
    assert (coin.color == validCollateralAssetType, "Invalid token type provided: Can not create collateral position");
    
    const disclosedCoin = disclose(coin);
    const disclosedCoinColor = disclose(coin.color);
    const depositId = ownPublicKey().bytes;
    const disclosedComplianceToken = disclose(complianceToken_);
    
    assert (trustedOracles.member(disclosedComplianceToken.tokenData.oraclePk), "Can not create position: Unauthorized KYC provider");

    /* Receives coin */
    recieveAndAddToProtocolReserveTVL(disclosedCoin);

    //Checks if there is an existing deposit vault for the user and updates the vault state
    if(depositors.member(depositId)){
        const currenDepositPosition = depositors.lookup(depositId);
        /* Hash metadata for shielding */
        const prevMetadata = getMintMetadata();
        const newCollateralAmount = (prevMetadata.collateral + disclosedCoin.value as Uint<64>) as Uint<64>;
        const newMetadata = MintMetadata{
            ...prevMetadata,
            collateral: newCollateralAmount,
            borrowLimit: DivisionFunction((LTV * newCollateralAmount) as Uint<64>, percent) as Uint<64>
        };
        const newMetadataHash = hashMintMetadata(newMetadata, depositId); 
        // Calculate new borrow limit
        set_mint_metadata(newMetadata);
        // Recalculates the borrowLimit
        
        depositors.insert(depositId, Depositor{
            ...currenDepositPosition,
            position: prevMetadata.collateral == 0 ? DebtPositionStatus.inactive : currenDepositPosition.position,
            metadataHash: newMetadataHash
        });
    }else{
        const depositorId = generateUserId(disclose(secrete_key()));
        const newBorrowLimit = DivisionFunction((LTV * disclosedCoin.value as Uint<64>) as Uint<64>, percent) as Uint<64>;
        const metadata = MintMetadata{
            collateral: disclosedCoin.value as Uint<64>,
            borrowLimit: newBorrowLimit,
            debt: 0
        };
        const metadataHash = hashMintMetadata(metadata, depositId);
        set_mint_metadata(metadata);

        depositors.insert(depositId, Depositor{
        ...default<Depositor>,
        id: depositorId,
        metadataHash: metadataHash,
        coinType: disclose(coin.color),
        entryOraclePrice: disclose(oraclePrice_)
    });
    }
}

export circuit mintSUSD( mintAmount_: Uint<64>): []{
    const disclosedMintAmount = disclose(mintAmount_) * stateritePersUSD;
    const depositId = ownPublicKey().bytes;
    assert (depositors.member(depositId), "Loan Position does not exist");

    const depositPosition = depositors.lookup(depositId);
    // Reconstructs depositor ID for security checks.
    const depositorId = generateUserId(disclose(secrete_key()));
    assert (depositorId == depositPosition.id, "Can not mint loan position: You are not the owner");
    
    // Reconstructs metadataHash for security checks
    const mintMetadata = getMintMetadata();
    const mintMetadataHash = hashMintMetadata(mintMetadata, depositId);
    assert (mintMetadataHash == depositPosition.metadataHash, "Invalid private state provided");

    assert (disclosedMintAmount <=  mintMetadata.borrowLimit, "Can not mint more than borrow limt");


    const newNonce = evolveNonce(mintCounter, nonce);
    mintToken(pad(32, "sUSD_token"), disclosedMintAmount as Uint<64>, newNonce, left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()));
    // Reconstructs and update metadataHash with new mint amount
    const newBorrowLimit = disclosedMintAmount <= mintMetadata.borrowLimit ? (mintMetadata.borrowLimit - disclosedMintAmount) : 0;
    const newMintMetadata = MintMetadata{
        ...mintMetadata,
        debt: (mintMetadata.debt + disclosedMintAmount) as Uint<64>,
        borrowLimit: newBorrowLimit
    };

    // Set mint_metadata private state
    set_mint_metadata(newMintMetadata);
    const newMetadataHash = hashMintMetadata(newMintMetadata, depositId);
    //Updates the depositor list    
    depositors.insert(depositId, Depositor{
        ...depositPosition,
        position: DebtPositionStatus.active,
        metadataHash: newMetadataHash
    });

    // Updates ledger states for the next mint
    nonce = newNonce;
    mintCounter.increment(1);
    totalMint = totalMint + disclosedMintAmount as Uint<128>;
}   


export circuit withdrawCollateral(amountToWithdraw_: Uint<32>, oraclePrice_: Uint<64>): [] { 
    const depositId = ownPublicKey().bytes;
    const disclosedAmtToWithdraw = disclose(amountToWithdraw_) * scaleFactor;
   
   assert (depositors.member(depositId), "Deposit with the required id does not exist");

   const depositPositionToWthdraw = depositors.lookup(depositId);
   
   // Checks the user is the authorized depositor
   const reconstructedDepositorsId = generateUserId(disclose(secrete_key()));
   assert (reconstructedDepositorsId == depositPositionToWthdraw.id, "Can not withdrawal collateral: You are not the owner");
   
   // Reconstructs the metadata hash from private state
   const metadata = getMintMetadata();
   const metadataHash = hashMintMetadata(metadata, depositId);

   // Checks to see if user has maliciously uttered private state
   assert (metadataHash == depositPositionToWthdraw.metadataHash, "Can not withdraw collateral: Invalid private state");
   assert (depositPositionToWthdraw.position != DebtPositionStatus.closed, "Can not withdrawl collateral: Your position has been liquidated");
   // Minimum Collateral Value, Calculated using (Debt * MCR)
   const MCV = DivisionFunction((metadata.debt * MCR) as Uint<64>, percent);
   const withdrawableCollateral = DivisionFunction(((metadata.collateral * oraclePrice_) - MCV) as Uint<64>, oraclePrice_);
   // Asserts that the amount to withdraw is not greater than the collateral
   assert (disclosedAmtToWithdraw <= withdrawableCollateral, "Can not withdraw more than available collateral deposited");
   const balance = metadata.collateral - disclosedAmtToWithdraw;    
   // Send funds and manage change
   sendFromProtocolReserveAndManageChange(ownPublicKey(), disclosedAmtToWithdraw as Uint<64>, validCollateralAssetType);

   const newBorrowLimit = DivisionFunction((LTV * balance) as Uint<64>, percent) as Uint<64>;
   
   const newMetadata = MintMetadata {
    ...metadata,
    collateral: balance,
    borrowLimit: newBorrowLimit
   };

   const newMintMetadataHash = hashMintMetadata(newMetadata, depositId);
   // Sets mint_metadata private state
   set_mint_metadata(newMetadata);
   // Updates the ledger state
   if(depositPositionToWthdraw.position == DebtPositionStatus.inactive){
        depositors.insert(depositId, Depositor{
        ...depositPositionToWthdraw,
        position: DebtPositionStatus.closed,
        metadataHash: newMintMetadataHash,
        });
   }else{
        depositors.insert(depositId, Depositor{
            ...depositPositionToWthdraw,
            metadataHash: newMintMetadataHash,
        });
   }
}


export circuit repay( coin: CoinInfo, amountToRepay_: Uint<32> ): [] {
   const depositId = ownPublicKey().bytes;
   const disclosedAmtToRepay = disclose(amountToRepay_) * scaleFactor;
   const disclosedCoin = disclose(coin);

   assert (depositors.member(depositId), "Deposit with the required id does not exist");
   
   const depositPosition = depositors.lookup(depositId);
   assert (depositPosition.position == DebtPositionStatus.active, "Cannot repay an inactive, closed or liquidated c0llateral position");
   
   // Reconstruct the metadata hash from private state
   const mintMetadata = getMintMetadata();
   const mintMetadataHash = hashMintMetadata(mintMetadata, depositId);
   
   //  Asserts to see if user has maliciously uttered private state
   assert (mintMetadataHash == depositPosition.metadataHash, "Can not withdraw collateral: Invalid private state");
   
   assert (coin.color == sUSDTokenType, "Can not repay minted sUSD: Invalid token type provided");
   assert (disclosedAmtToRepay <= mintMetadata.debt, "Can not repay minted sUSD: tokens must be equivalent to the amount of sUSD minted");
   assert (disclosedAmtToRepay >= coin.value, "Can not repay minted sUSD: Insufficient tokens provided to cover amount to repay");
   
   const balanceToRepay = mintMetadata.debt - disclosedAmtToRepay; 
   
    //Generates and send token to a burn address
    const burnAddrs = burnAddress();

    receive(disclosedCoin);
    //Send immediately to desired address
    sendImmediate(disclosedCoin, burnAddrs, disclosedAmtToRepay);

    // Updates MintMetadata (private state)
    const newBorrowLimit = (mintMetadata.borrowLimit + disclosedAmtToRepay) as Uint<64>;
    const newMintMetadata = MintMetadata {
    ...mintMetadata,
    debt: balanceToRepay,
    borrowLimit: newBorrowLimit
   };

   const newMintMetadataHash = hashMintMetadata(newMintMetadata, depositId);
   // Set mint_metadata private state
   set_mint_metadata(newMintMetadata);

   if (balanceToRepay > 0) {
        depositors.insert(depositId, Depositor{
            ...depositPosition,
            metadataHash: newMintMetadataHash,
        });
    }else{
        depositors.insert(depositId, Depositor {
            ...depositPosition,
            metadataHash: newMintMetadataHash,
            position: DebtPositionStatus.closed,
        });
    }
}


/* LIQUIDATOR'S INTERACTIONS */
export circuit liquidateDebtPosition(
    collateralAmt_: Uint<64>, 
    depositId_: Bytes<32>, 
    debt_: Uint<64>,
    oraclePrice_: Uint<32>
    ):[]{
    // Checks if the loan positon exist
    assert (depositors.member(disclose(depositId_)), "Deposit with the required Id does not exist");
    const depositPosition = depositors.lookup(disclose(depositId_)); 
    // Recalculate Health factor
    const healthFactor = DivisionFunction((liquidationThreshold * collateralAmt_ * oraclePrice_) as Uint<64>, (debt_ * percent) as Uint<64>);
    assert (healthFactor < 1, "Can not liquidate a healthy deposit position");

    assert (protocolStakeTVL.value >= disclose(debt_), "Insufficient Funds in stake pool");
    // Burns equivalent amount of minted asset from the protocolStakeTVL in order to regulate the circulation of sUSD
    const burnAddrs = burnAddress();
    const sendResult = send(protocolStakeTVL, burnAddrs, disclose(debt_));
    if(sendResult.change.is_some){
        protocolStakeTVL.writeCoin(sendResult.change.value, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
    }else{
      // Reset Pool total if there's no change left
      protocolStakeTVL.resetToDefault();
    }
    // Calculates ADA_sUSD_index using liquidatedCollateral / sUSD_Pool_ Total
    const current_ADA_sUSD_index = DivisionFunction(disclose(collateralAmt_) as Uint<64>, protocolStakeTVL.value as Uint<64>) as Uint<128>;
    ADA_sUSD_index = (ADA_sUSD_index + current_ADA_sUSD_index) as Uint<128>;
    // Calculates and update the cumulative scaling factor
    const loss_ratio = DivisionFunction(disclose(debt_), protocolStakeTVL.value as Uint<64>);
    cumulativeScalingFactor = cumulativeScalingFactor * (1 - loss_ratio);
    
    // Sets user's private state
    set_mint_metadata(MintMetadata {
        collateral: 0,
        debt: 0,
        borrowLimit: 0
    });
    // Updates deposit state in the mapping
    depositors.insert(disclose(depositId_), Depositor {
        ...depositPosition,    
        position: DebtPositionStatus.closed,
    });

    liquidationCount.increment(1);
}
