module Swap{
    import CompactStandardLibrary;
    import "./GlobalProtocolLedgerStates";


    /* Entry point for swapping other stable coin to sUSD on a 1:1 basis */
    export circuit swapForsUSD(coin_: CoinInfo): []{
        const disclosedCoin = disclose(coin_);
        /* Recieve token */
        recieveAndAddToProtocolReserveTVL(disclosedCoin);
        
        /* Mint sUSD */
        const newNonce = evolveNonce(mintCounter, nonce);
        mintToken(pad(32, "sUSD_token"), disclosedCoin.value as Uint<64>, newNonce, left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()));
    }

    /* Entry point for swapping sUSD to other stable coin */
    export circuit swapsUSDForToken(coin_: CoinInfo, tokenType_: Bytes<32>): []{
        const disclosedCoin = disclose(coin_);
        const disclosedTokenType = disclose(tokenType_);
        assert (acceptedSwapTokens.member(disclosedTokenType), "Can not swap sUSD for specified token type");
        
        const burnAddrs = burnAddress();
        /* Burn returned sUSD  */
        receive(disclosedCoin);
        //Send immediately to desired address
        sendImmediate(disclosedCoin, burnAddrs, disclosedCoin.value);
        /* Send stablecoin and manage balance */
        sendFromProtocolReserveAndManageChange(ownPublicKey(), disclosedCoin.value as Uint<64>, disclosedTokenType);
    }
}