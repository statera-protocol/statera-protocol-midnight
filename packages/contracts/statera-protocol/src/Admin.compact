module Admin {
    import CompactStandardLibrary;
    import GlobalProtocolLedgerStates;
    import Utils;

    /* Tracks the list of trustd kyc oracle networks */
    export ledger trustedOracles: Set<Bytes<32>>;

    /* INTERACTION FOR ADMIN ONLY*/
    export circuit resetProtocolConfig(_liquidationThreshold: Uint<8>, _LTV: Uint<8>, _MCR: Uint<8>, requester_addrs: Bytes<32>): []{
        const adminId = generateUserId(disclose(requester_addrs), pad(32, "susd:admin"));
        assert (adminId == superAdmin || admins.member(adminId), "Can not set SUSD token type: Unauthorized");

        liquidationThreshold = disclose(_liquidationThreshold);
        LTV = disclose(_LTV);
        MCR = disclose(_MCR);
    }

    export circuit setSUSDTokenType(requester_addrs: Bytes<32>): []{
        const adminId = generateUserId(disclose(requester_addrs), pad(32, "susd:admin"));
        assert (ownPublicKey().bytes == superAdmin || admins.member(adminId), "Can not set SUSD token type: Unauthorized");

        sUSDTokenType = tokenType(pad(32, "sUSD_token"), kernel.self());
    }

    export circuit addTrustedOracle(oraclePk: Bytes<32>, requester_addrs: Bytes<32>): []{
        const disclosedOraclePk = disclose(oraclePk);

        const adminId = generateUserId(disclose(requester_addrs), pad(32, "susd:admin"));
        assert (ownPublicKey().bytes == superAdmin || admins.member(adminId), "Can not set SUSD token type: Unauthorized");

        assert (!trustedOracles.member(disclosedOraclePk), "Can not add oracle pk: Already exist");

        trustedOracles.insert(disclosedOraclePk);
    }

    export circuit removeTrustedOraclePk(oraclePk: Bytes<32>, requester_addrs: Bytes<32>): []{
        const disclosedOraclePk = disclose(oraclePk);

        const adminId = generateUserId(disclose(requester_addrs), pad(32, "susd:admin"));
        assert (ownPublicKey().bytes == superAdmin || admins.member(adminId), "Can not set SUSD token type: Unauthorized");

        assert (trustedOracles.member(disclosedOraclePk), "Can not add oracle public key: Does not exist");

        trustedOracles.remove(disclosedOraclePk);
    }


    export circuit addAdmin(newAdminAddrs: Bytes<32>, requester_addrs: Bytes<32>): []{
        const disclosedNewAdminAddrss = disclose(newAdminAddrs);
        const superAdminId = generateUserId(disclose(requester_addrs), pad(32, "susd:admin"));
        assert (ownPublicKey().bytes == superAdmin, "Can not add new admin: Unauthorized");
        // Construct Id for new admin
        const newAdminId = generateUserId(disclosedNewAdminAddrss, pad(32, "susd:admin"));
        assert (!admins.member(newAdminId), "Can not add admin: Already an admin");
        // Add the new admin ID to the list of authorized admins
        admins.insert(newAdminId);
    }

    export circuit transferSuperAdminRole(newAdminAddrs: Bytes<32>, requester_addrs: Bytes<32>): []{
        const disclosedNewAdminAddrss = disclose(newAdminAddrs);

        const superAdminId = generateUserId(disclose(requester_addrs), pad(32, "susd:admin"));
        assert (ownPublicKey().bytes == superAdmin, "Can not add new admin: Unauthorized");

        // Construct Id for new admin
        const newSuperAdminId = generateUserId(disclosedNewAdminAddrss, pad(32, "susd:admin"));

        superAdmin = newSuperAdminId;
    }

    export circuit addSwapToken(token: Bytes<32>, requester_addrs: Bytes<32>): []{
        const disclosedToken = disclose(token);
        const adminId = generateUserId(disclose(requester_addrs), pad(32, "susd:admin"));

        assert (ownPublicKey().bytes == superAdmin || admins.member(adminId), "Can not add new swap token: Unauthorized");
        assert (!acceptedSwapTokens.member(disclosedToken), "Can not add new token: ALready exists");

        acceptedSwapTokens.insert(disclosedToken);
    }

}